# MongoDB Configuration
SPRING_DATA_MONGODB_URI=mongodb://root:rootpassword@localhost:27017/patrimonial?authSource=admin&replicaSet=rs0
MONGODB_USERNAME=root
MONGODB_PASSWORD=rootpassword

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=patrimonial-service

# Application Configuration
SERVER_PORT=8080
SPRING_PROFILE=dev

# Idempotency Configuration
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400

# Kafka Events Configuration
KAFKA_EVENTS_ENABLED=true
KAFKA_TOPIC_PREFIX=patrimonial

# Outbox Configuration
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ITAU=DEBUG

# Security (if using OAuth2)
OAUTH2_ISSUER_URI=https://auth.example.com
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
